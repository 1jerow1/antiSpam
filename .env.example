# Токен бота от @BotFather
BOT_TOKEN=123456789:ABCdefYourBotTokenHere

# Telegram user id администратора (узнать можно у @userinfobot)
ADMIN_ID=000000000

# Ollama (по умолчанию — локальный инстанс)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3:8b

# Необязательные параметры (значения по умолчанию)
# STATS_FILE=stats.json
# WHITELIST_FILE=whitelist.json
# MAX_TEXT_LENGTH=500

# ML-классификатор (гибридный режим, см. README)
# DATASET_FILE=dataset.jsonl
# MODEL_FILE=model.joblib
# MODEL_META_FILE=model_meta.json
# ML_CONFIDENCE_THRESHOLD=0.85

# Каталог для stats/whitelist/датасета/модели (по умолчанию — текущая папка;
# на Railway берётся из подключённого тома автоматически)
# DATA_DIR=/data

# Чистый ML без Ollama (Railway): false отключает Ollama целиком
# USE_OLLAMA=true
# Порог удаления P(NOT_SALE); по умолчанию подбирается при обучении (/train)
# ML_DELETE_THRESHOLD=
# Минимум SALE-примеров, чтобы обучение выдало порог удаления
# ML_MIN_SALE_EXAMPLES=100
# Банить ботов, добавленных в чат не администратором (true/false)
# BLOCK_BOTS=true
